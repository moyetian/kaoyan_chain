/* ============================================================================
   考研学习链 GUI · 唯一结构样式模板 (Single Structural QSS Template)
   ----------------------------------------------------------------------------
   这里只写「结构与布局」，颜色/圆角/字号/间距一律走 token 占位
   （双花括号包住 token 名，如 acc、radius、fs-base；取值见 tools/theme/tokens.py）。
   加一套新主题 = 加一组 token，而不是再抄一份 163 行的样式表 ——
   改造前 dark.qss / light.qss 正是两份逐条手写的完整副本。

   占位符由 tools/theme/compile_qt.py 注入；引用未定义的 token 会直接报错，
   避免出现「样式里写了一个预设中不存在的色名」导致的静默失效。
   ========================================================================== */

QMainWindow, QWidget {
    background-color: {{bg}};
    color: {{fg}};
    font-family: {{font-family}};
}

/* 全局标签默认背景透明，彻底消除容器内的白色方块底色 */
QLabel {
    background-color: transparent;
    color: {{fg}};
}

/* 键盘用户必须能看见焦点落在哪里（改造前全站 :focus 样式为 0 处） */
*:focus {
    outline: {{focus-w}}px solid {{focus-ring}};
    outline-offset: 1px;
}

#HeaderBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {{surf}}, stop:1 {{surf2}});
    border-radius: {{radius}}px;
    border: 1px solid {{line}};
    padding: {{pad}} {{pad-lg}};
}

#HeaderBar QLabel {
    background-color: transparent;
}

#Countdown {
    background-color: transparent;
    color: {{warn}};
    font-size: {{fs-lg}};
    font-weight: bold;
    padding: 0 4px;
}

#HeaderTitle {
    background-color: transparent;
    color: {{acc-soft}};
    font-size: {{fs-lg}};
    font-weight: bold;
}

#MetaLabel {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-sm}};
}

/* 次要状态文字（如微信检索对话框的状态行） */
#StatusLabel {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-sm}};
}

#FunctionCard {
    background-color: {{surf}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    padding: 2px;
}

#FunctionCard QLabel {
    background-color: transparent;
}

#FunctionCard:hover {
    background-color: {{surf3}};
    border: 1.5px solid {{acc}};
}

#FunctionCard:focus {
    border: {{focus-w}}px solid {{focus-ring}};
}

#CardTitle {
    background-color: transparent;
    color: {{acc-soft}};
    font-weight: bold;
    font-size: {{fs-base}};
}

#CardDesc {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-sm}};
}

#CardScrollArea {
    background-color: transparent;
    border: none;
}

/* 主页任务行 */
#TaskRow {
    background-color: {{surf}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
}

#TaskRow QLabel {
    background-color: transparent;
}

#TaskRow:hover {
    border: 1px solid {{acc}};
}

#TaskLabel {
    background-color: transparent;
    color: {{fg}};
    font-size: {{fs-base}};
}

#TaskPct {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-sm}};
}

/* 主页顶部快捷胶囊 */
#QuickPill {
    background-color: {{acc-sub}};
    color: {{acc-soft}};
    border: 1px solid {{acc-line}};
    border-radius: {{radius-sm}}px;
    padding: {{pad-sm}} {{pad}};
    font-weight: 600;
    font-size: {{fs-sm}};
}

#QuickPill:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
}

#ThemeToggle {
    background-color: {{surf2}};
    color: {{acc-soft}};
    border: 1px solid {{acc-line}};
    border-radius: {{radius-sm}}px;
    padding: {{pad-sm}} {{pad}};
    font-size: {{fs-sm}};
}

#ThemeToggle:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
}

#SettingsBtn {
    background-color: {{surf2}};
    color: {{fg}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    padding: {{pad-sm}} {{pad}};
    font-size: {{fs-sm}};
}

#SettingsBtn:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
}

#UploadBtn {
    background-color: {{surf2}};
    color: {{fg}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    padding: {{pad-sm}} {{pad}};
    font-size: {{fs-sm}};
    font-weight: 500;
}

#UploadBtn:hover {
    background-color: {{surf3}};
    color: {{acc-soft}};
    border: 1px solid {{acc}};
}

#UploadBtn:pressed {
    background-color: {{acc-sub}};
}

QProgressBar {
    background-color: {{input-bg}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    text-align: center;
    color: {{fg-strong}};
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {{acc-grad-from}}, stop:1 {{acc-grad-to}});
    border-radius: {{radius-sm}}px;
}

/* 标签页主体与 TabBar 隔离分层设计 */
QTabWidget {
    border: none;
    background-color: transparent;
}

QTabWidget::pane {
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    background-color: {{surf}};
    top: -1px;
    padding: 12px;
}

QTabWidget::tab-bar {
    alignment: left;
    left: 8px;
}

QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: {{surf2}};
    color: {{mut}};
    padding: 9px 22px;
    border: 1px solid {{line}};
    border-top-left-radius: {{radius-sm}}px;
    border-top-right-radius: {{radius-sm}}px;
    margin-right: 6px;
    margin-top: 3px;
    font-size: {{fs-base}};
    font-weight: 500;
    min-height: 26px;
}

QTabBar::tab:selected {
    background-color: {{surf}};
    color: {{acc-soft}};
    border: 1px solid {{line}};
    border-bottom: 2px solid {{acc}};
    font-weight: bold;
    margin-top: 0px;
}

QTabBar::tab:hover:!selected {
    background-color: {{surf3}};
    color: {{fg-strong}};
    border: 1px solid {{line-strong}};
}

QPushButton {
    background-color: {{acc}};
    color: {{on-acc}};
    border: 1px solid {{acc-line}};
    padding: {{pad}} {{pad-lg}};
    border-radius: {{radius-sm}}px;
    font-size: {{fs-base}};
    font-weight: 600;
    min-height: 22px;
}

QPushButton:hover {
    background-color: {{acc-hover}};
}

QPushButton:pressed {
    background-color: {{acc-press}};
}

QPushButton:disabled {
    background-color: {{surf3}};
    color: {{mut}};
    border: 1px solid {{line}};
}

/* 次要/轮廓按钮 */
QPushButton#SecondaryBtn, QPushButton[secondary="true"] {
    background-color: {{surf2}};
    color: {{fg-strong}};
    border: 1px solid {{line-strong}};
}

QPushButton#SecondaryBtn:hover, QPushButton[secondary="true"]:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
    color: {{acc-soft}};
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: {{input-bg}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    padding: {{pad}} {{pad}};
    color: {{fg-strong}};
    font-size: {{fs-base}};
    selection-background-color: {{acc}};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid {{acc}};
}

QTableWidget {
    background-color: {{input-bg}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    gridline-color: {{grid-line}};
    color: {{fg-strong}};
}

QHeaderView::section {
    background-color: {{surf}};
    color: {{mut}};
    padding: {{pad-sm}};
    border: none;
    border-bottom: 1px solid {{line}};
    font-weight: bold;
}

QTableWidget::item:selected {
    background-color: {{sel-bg}};
    color: {{sel-fg}};
}

QScrollBar:vertical {
    background-color: {{bg}};
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: {{line-strong}};
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{mut}};
}

QStatusBar {
    background-color: {{surf2}};
    color: {{mut}};
    font-size: {{fs-sm}};
}

QToolTip {
    background-color: {{surf3}};
    color: {{fg}};
    border: 1px solid {{line}};
    padding: {{pad-sm}};
}

/* ════════════════════════════════════════════════════════════════════════
   P2 组件族：导航 rail / 通用卡片 / 统计块 / 命令面板 / 对话气泡 / 错题卡
   全部消费 P0 设计系统 token（fs-hero|title|body|caption、space-1..6、icon-*）
   —— 新增组件只加选择器块，颜色/圆角/字号一律不在控件里写死。
   ════════════════════════════════════════════════════════════════════════ */

/* ── 左侧导航 rail：视图组（切页）+ 工具组（动作） ─────────────────── */
#NavRail {
    background-color: {{surf2}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
}

#NavRailScroll, #NavRailCanvas {
    background-color: transparent;
    border: none;
}

#NavBrand {
    background-color: transparent;
    color: {{acc-soft}};
    font-size: {{fs-title}};
    font-weight: bold;
}

#NavPaletteBtn {
    background-color: {{surf}};
    color: {{mut}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    padding: {{space-1}} {{space-2}};
    font-size: {{fs-caption}};
}

#NavPaletteBtn:hover {
    color: {{acc-soft}};
    border: 1px solid {{acc}};
}

#NavGroupTitle {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-caption}};
    font-weight: 600;
    padding: {{space-1}} {{space-2}};
}

/* 视图项：紧凑行。激活态 = 左侧 3px 强调条 + acc-sub 底（禁止巨型高亮） */
#NavItem {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: {{radius-sm}}px;
    color: {{fg}};
    font-size: {{fs-body}};
    font-weight: 500;
    text-align: left;
    padding: {{space-1}} {{space-2}};
    /* 点区高度：QSS 的 min-height 会覆盖控件 setMinimumHeight（全局 QPushButton
       规则是 22px），故在此显式声明 30px —— 加 padding 4+4 后渲染高度 38px，
       与 KYNavItem 的代码意图一致，点击目标不缩水。 */
    min-height: 30px;
}

#NavItem:hover {
    background-color: {{surf3}};
    color: {{fg-strong}};
}

#NavItem:checked {
    background-color: {{acc-sub}};
    border-left: 3px solid {{acc}};
    color: {{acc-soft}};
    font-weight: 600;
}

/* 工具项：动作卡（图标 + 标题 + 说明） */
#NavToolItem {
    background-color: {{surf}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
}

#NavToolItem:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
}

#NavToolItem:focus {
    border: {{focus-w}}px solid {{focus-ring}};
}

#NavToolTitle {
    background-color: transparent;
    color: {{fg-strong}};
    font-size: {{fs-body}};
    font-weight: 600;
}

#NavToolDesc {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-caption}};
}

/* ── 命令面板（Ctrl+K） ──────────────────────────────────────────── */
#PaletteDialog {
    background-color: {{bg}};
    border: 1px solid {{line-strong}};
}

#PaletteInput {
    background-color: {{input-bg}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    padding: {{space-2}} {{space-3}};
    color: {{fg-strong}};
    font-size: {{fs-body}};
}

#PaletteInput:focus {
    border: 1.5px solid {{acc}};
}

#PaletteList {
    background-color: transparent;
    border: none;
    outline: none;
}

#PaletteList::item {
    color: {{fg}};
    border-radius: {{radius-sm}}px;
    padding: {{space-2}} {{space-3}};
    font-size: {{fs-body}};
}

#PaletteList::item:selected {
    background-color: {{acc-sub}};
    color: {{acc-soft}};
}

#PaletteHint {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-caption}};
}

/* ── 对话页：气泡 + 空状态示例 ──────────────────────────────────── */
#ChatView {
    background-color: {{input-bg}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
}

#ChatCanvas {
    background-color: transparent;
}

#ChatEmptyTitle {
    background-color: transparent;
    color: {{fg-strong}};
    font-size: {{fs-title}};
    font-weight: 600;
}

#ChatEmptyHint {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-body}};
}

#ExamplePill {
    background-color: {{surf2}};
    color: {{acc-soft}};
    border: 1px dashed {{acc-line}};
    border-radius: {{radius-sm}}px;
    padding: {{space-1}} {{space-3}};
    font-size: {{fs-sm}};
    font-weight: 500;
}

#ExamplePill:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
}

#UserBubble {
    background-color: {{acc-sub}};
    border: 1px solid {{acc-line}};
    border-radius: {{radius-sm}}px;
    color: {{fg-strong}};
}

#AgentBubble {
    background-color: {{surf}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    color: {{fg}};
}

#SystemBubble {
    background-color: transparent;
    border: 1px dashed {{line-strong}};
    border-radius: {{radius-sm}}px;
    color: {{mut}};
}

#BubbleText {
    background-color: transparent;
    font-size: {{fs-body}};
}

#BubbleMeta {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-caption}};
    font-weight: 600;
}

/* ── 错题本：卡片 + chip ────────────────────────────────────────── */
#ErrorScroll, #ErrorCanvas {
    background-color: transparent;
    border: none;
}

#KYCard {
    background-color: {{surf}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
}

#KYCard:hover {
    border: 1px solid {{acc}};
}

#KYCardHeader, #KYCardTitle, #KYCardMeta {
    background-color: transparent;
}

#KYCardTitle {
    color: {{fg-strong}};
    font-size: {{fs-body}};
    font-weight: 600;
}

#KYCardMeta {
    color: {{mut}};
    font-size: {{fs-caption}};
}

#CardChip {
    background-color: {{acc-sub}};
    color: {{acc-soft}};
    border: 1px solid {{acc-line}};
    border-radius: {{radius-sm}}px;
    padding: 1px {{space-2}};
    font-size: {{fs-caption}};
    font-weight: 600;
}

#DueChip {
    background-color: transparent;
    color: {{warn}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    padding: 1px {{space-2}};
    font-size: {{fs-caption}};
}

#ErrChip {
    background-color: transparent;
    color: {{bad}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    padding: 1px {{space-2}};
    font-size: {{fs-caption}};
}

#EmptyHint {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-body}};
    padding: {{space-3}};
}

/* ── 今日任务页：概览统计块（大数字 + caption + 可选趋势） ─────────── */
#StatTile {
    background-color: {{surf}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
}

#StatValue {
    background-color: transparent;
    color: {{acc-soft}};
    font-size: {{fs-hero}};
    font-weight: bold;
}

#StatCaption {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-caption}};
}

#StatTrend {
    background-color: transparent;
    color: {{ok}};
    font-size: {{fs-caption}};
}

#StatTrend[tone="warn"] {
    color: {{warn}};
}

#StatTrend[tone="bad"] {
    color: {{bad}};
}

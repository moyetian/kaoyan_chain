/* ============================================================================
   考研学习链 GUI · 唯一结构样式模板 (Single Structural QSS Template)
   ----------------------------------------------------------------------------
   这里只写「结构与布局」，颜色/圆角/字号/间距一律走 token 占位
   （双花括号包住 token 名，如 acc、radius、fs-base；取值见 tools/theme/tokens.py）。
   加一套新主题 = 加一组 token，而不是再抄一份 163 行的样式表 ——
   改造前 dark.qss / light.qss 正是两份逐条手写的完整副本。

   占位符由 tools/theme/compile_qt.py 注入；引用未定义的 token 会直接报错，
   避免出现「样式里写了一个预设中不存在的色名」导致的静默失效。
   ========================================================================== */

QMainWindow, QWidget {
    background-color: {{bg}};
    color: {{fg}};
    font-family: {{font-family}};
}

/* 全局标签默认背景透明，彻底消除容器内的白色方块底色 */
QLabel {
    background-color: transparent;
    color: {{fg}};
}

/* 键盘用户必须能看见焦点落在哪里（改造前全站 :focus 样式为 0 处） */
*:focus {
    outline: {{focus-w}}px solid {{focus-ring}};
    outline-offset: 1px;
}

#HeaderBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {{surf}}, stop:1 {{surf2}});
    border-radius: {{radius}}px;
    border: 1px solid {{line}};
    padding: {{pad}} {{pad-lg}};
}

#HeaderBar QLabel {
    background-color: transparent;
}

#Countdown {
    background-color: transparent;
    color: {{warn}};
    font-size: {{fs-lg}};
    font-weight: bold;
    padding: 0 4px;
}

#HeaderTitle {
    background-color: transparent;
    color: {{acc-soft}};
    font-size: {{fs-lg}};
    font-weight: bold;
}

#MetaLabel {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-sm}};
}

/* 次要状态文字（如微信检索对话框的状态行） */
#StatusLabel {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-sm}};
}

#FunctionCard {
    background-color: {{surf}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    padding: 2px;
}

#FunctionCard QLabel {
    background-color: transparent;
}

#FunctionCard:hover {
    background-color: {{surf3}};
    border: 1.5px solid {{acc}};
}

#FunctionCard:focus {
    border: {{focus-w}}px solid {{focus-ring}};
}

#CardTitle {
    background-color: transparent;
    color: {{acc-soft}};
    font-weight: bold;
    font-size: {{fs-base}};
}

#CardDesc {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-sm}};
}

#CardScrollArea {
    background-color: transparent;
    border: none;
}

/* 主页任务行 */
#TaskRow {
    background-color: {{surf}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
}

#TaskRow QLabel {
    background-color: transparent;
}

#TaskRow:hover {
    border: 1px solid {{acc}};
}

#TaskLabel {
    background-color: transparent;
    color: {{fg}};
    font-size: {{fs-base}};
}

#TaskPct {
    background-color: transparent;
    color: {{mut}};
    font-size: {{fs-sm}};
}

/* 主页顶部快捷胶囊 */
#QuickPill {
    background-color: {{acc-sub}};
    color: {{acc-soft}};
    border: 1px solid {{acc-line}};
    border-radius: {{radius-sm}}px;
    padding: {{pad-sm}} {{pad}};
    font-weight: 600;
    font-size: {{fs-sm}};
}

#QuickPill:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
}

#ThemeToggle {
    background-color: {{surf2}};
    color: {{acc-soft}};
    border: 1px solid {{acc-line}};
    border-radius: {{radius-sm}}px;
    padding: {{pad-sm}} {{pad}};
    font-size: {{fs-sm}};
}

#ThemeToggle:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
}

#SettingsBtn {
    background-color: {{surf2}};
    color: {{fg}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    padding: {{pad-sm}} {{pad}};
    font-size: {{fs-sm}};
}

#SettingsBtn:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
}

#UploadBtn {
    background-color: {{surf2}};
    color: {{fg}};
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    padding: {{pad-sm}} {{pad}};
    font-size: {{fs-sm}};
    font-weight: 500;
}

#UploadBtn:hover {
    background-color: {{surf3}};
    color: {{acc-soft}};
    border: 1px solid {{acc}};
}

#UploadBtn:pressed {
    background-color: {{acc-sub}};
}

QProgressBar {
    background-color: {{input-bg}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    text-align: center;
    color: {{fg-strong}};
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 {{acc-grad-from}}, stop:1 {{acc-grad-to}});
    border-radius: {{radius-sm}}px;
}

/* 标签页主体与 TabBar 隔离分层设计 */
QTabWidget {
    border: none;
    background-color: transparent;
}

QTabWidget::pane {
    border: 1px solid {{line}};
    border-radius: {{radius-sm}}px;
    background-color: {{surf}};
    top: -1px;
    padding: 12px;
}

QTabWidget::tab-bar {
    alignment: left;
    left: 8px;
}

QTabBar {
    background-color: transparent;
    qproperty-drawBase: 0;
}

QTabBar::tab {
    background-color: {{surf2}};
    color: {{mut}};
    padding: 9px 22px;
    border: 1px solid {{line}};
    border-top-left-radius: {{radius-sm}}px;
    border-top-right-radius: {{radius-sm}}px;
    margin-right: 6px;
    margin-top: 3px;
    font-size: {{fs-base}};
    font-weight: 500;
    min-height: 26px;
}

QTabBar::tab:selected {
    background-color: {{surf}};
    color: {{acc-soft}};
    border: 1px solid {{line}};
    border-bottom: 2px solid {{acc}};
    font-weight: bold;
    margin-top: 0px;
}

QTabBar::tab:hover:!selected {
    background-color: {{surf3}};
    color: {{fg-strong}};
    border: 1px solid {{line-strong}};
}

QPushButton {
    background-color: {{acc}};
    color: {{on-acc}};
    border: 1px solid {{acc-line}};
    padding: {{pad}} {{pad-lg}};
    border-radius: {{radius-sm}}px;
    font-size: {{fs-base}};
    font-weight: 600;
    min-height: 22px;
}

QPushButton:hover {
    background-color: {{acc-hover}};
}

QPushButton:pressed {
    background-color: {{acc-press}};
}

QPushButton:disabled {
    background-color: {{surf3}};
    color: {{mut}};
    border: 1px solid {{line}};
}

/* 次要/轮廓按钮 */
QPushButton#SecondaryBtn, QPushButton[secondary="true"] {
    background-color: {{surf2}};
    color: {{fg-strong}};
    border: 1px solid {{line-strong}};
}

QPushButton#SecondaryBtn:hover, QPushButton[secondary="true"]:hover {
    background-color: {{surf3}};
    border: 1px solid {{acc}};
    color: {{acc-soft}};
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: {{input-bg}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    padding: {{pad}} {{pad}};
    color: {{fg-strong}};
    font-size: {{fs-base}};
    selection-background-color: {{acc}};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1.5px solid {{acc}};
}

QTableWidget {
    background-color: {{input-bg}};
    border: 1px solid {{line-strong}};
    border-radius: {{radius-sm}}px;
    gridline-color: {{grid-line}};
    color: {{fg-strong}};
}

QHeaderView::section {
    background-color: {{surf}};
    color: {{mut}};
    padding: {{pad-sm}};
    border: none;
    border-bottom: 1px solid {{line}};
    font-weight: bold;
}

QTableWidget::item:selected {
    background-color: {{sel-bg}};
    color: {{sel-fg}};
}

QScrollBar:vertical {
    background-color: {{bg}};
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: {{line-strong}};
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: {{mut}};
}

QStatusBar {
    background-color: {{surf2}};
    color: {{mut}};
    font-size: {{fs-sm}};
}

QToolTip {
    background-color: {{surf3}};
    color: {{fg}};
    border: 1px solid {{line}};
    padding: {{pad-sm}};
}
